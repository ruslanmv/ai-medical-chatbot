# MedOS deployment under test.
# Local dev: http://localhost:3000
# HF Space:  https://ruslanmv-medibot.hf.space
MEDOS_BASE_URL=http://localhost:3000

# Optional — auth token for the MedOS API. Leave blank to benchmark the
# guest path (inline <patient_context> injection from the dataset). With
# a token, the server-side EHR is used and the dataset profile is
# injected only as a backstop.
MEDOS_AUTH_TOKEN=

# OpenAI key for the ChatGPT baseline.
OPENAI_API_KEY=sk-...

# Which OpenAI model the baseline uses. gpt-4o-mini is the closest cost
# peer to our free-tier OllaBridge routes; gpt-4o is the harder bar.
OPENAI_MODEL=gpt-4o-mini
