# ============================================================
# MedOS Web — server configuration
# ============================================================
# The Vercel deployment now hosts the MedOS orchestrator at
# /api/chat (web/app/api/chat/route.ts). The orchestrator owns
# the AI-first product logic: typed action routing, conversation-
# state derivation, doctor-summary generation, and context-switch
# hinting. LLM inference is delegated to OllaBridge Cloud.
#
# Legacy /api/proxy/* still forwards to the HuggingFace Space for
# the non-chat endpoints (auth, EHR sync, nearby, ...) until those
# also move behind OllaBridge.

# ---- LLM gateway: OllaBridge Cloud ----
# Required for /api/chat to work. The orchestrator calls the
# OpenAI-compatible /v1/chat/completions on this base URL.
# IMPORTANT: keep OLLABRIDGE_API_KEY server-side only — never
# inline it into a NEXT_PUBLIC_* var.
OLLABRIDGE_BASE_URL=https://your-ollabridge-domain/v1
OLLABRIDGE_API_KEY=ob_replace_with_an_admin-minted_key
OLLABRIDGE_MODEL=local-private
OLLABRIDGE_TIMEOUT_MS=45000

# ---- Legacy backend for non-chat routes ----
# Used by /api/proxy/* for auth / nearby / EHR until those endpoints
# are migrated. Leave unset to run frontend-only.
NEXT_PUBLIC_BACKEND_URL=https://ruslanmv-medibot.hf.space
