# ============================================================
# MedOS Web — server configuration
# ============================================================
# The Vercel deployment hosts the UI and proxies all backend
# requests to the HuggingFace Space at
# huggingface.co/spaces/ruslanmv/MediBot (URL ruslanmv-medibot.hf.space).
#
# The Space owns the entire chat pipeline:
#   - System-prompt build, RAG, intent classification
#   - Safety pre/post checks
#   - Provider fallback chain (Groq → OllaBridge → HF Inference)
#   - Admin SQLite store (LLM keys, model defaults)
#
# Vercel therefore needs almost no env vars — just the backend URL
# and any non-chat proxy settings.

# ---- HF Space backend (required) ----
# Used by both /api/chat (the streaming proxy) and /api/proxy/*
# (auth, EHR sync, nearby, admin, ...).
HF_BACKEND_URL=https://ruslanmv-medibot.hf.space
# Same value, exposed to the client for legacy /api/proxy paths.
NEXT_PUBLIC_BACKEND_URL=https://ruslanmv-medibot.hf.space

# Optional: timeout in ms for the /api/chat proxy fetch. Default
# 50000. Vercel function cap is 60000 — leave headroom.
# HF_BACKEND_TIMEOUT_MS=50000
